{
  "name": "dream-tutors-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "preview": "tsx scripts/dev.ts --prod",
    "build": "next build",
    "vercel-build": "npm run db:deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/pg.ts start",
    "db:stop": "tsx scripts/pg.ts stop",
    "db:status": "tsx scripts/pg.ts status",
    "db:destroy": "tsx scripts/pg.ts destroy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:deploy": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "jobs:run": "tsx --conditions=react-server scripts/run-jobs.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "15.5.23",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "rollup": "4.62.5"
  }
}
